# 后端环境变量模板：复制本文件为 videohub/backend/.env 后按需修改
# 所有变量带 VIDEOHUB_ 前缀，由 app/config.py 读取；本地手动部署时才需要，Docker 部署由容器注入

# 会话签名密钥：留空则首次启动自动生成随机值并写回本文件
VIDEOHUB_SECRET_KEY=

# 可选：首次创建管理员账户时的初始密码（留空则自动生成随机密码，打印到日志并写回 .env）
VIDEOHUB_ADMIN_PASSWORD=

# SQLite 数据库连接串（默认当前目录下的 videohub.db）
# VIDEOHUB_DB_URL=sqlite:///./videohub.db

# 监听地址与端口（建议始终 127.0.0.1，公网入口交给反向代理/隧道）
# VIDEOHUB_HOST=127.0.0.1
# VIDEOHUB_PORT=8000

# 上游视频代理超时（秒），解析慢源可适当调大
# VIDEOHUB_UPSTREAM_TIMEOUT=300

# 会话 Cookie 是否仅 HTTPS 传输：公网隧道全 HTTPS 时置 1；本地 http 访问保持 0
# VIDEOHUB_COOKIE_SECURE=0

# 前端构建产物静态目录（默认自动定位 backend/static，一般无需设置）
# VIDEOHUB_STATIC_DIR=
